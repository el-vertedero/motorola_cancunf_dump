	clkchk {
		compatible = "mediatek,mt6855-clkchk";
	};

	pdchk {
		compatible = "mediatek,mt6855-pdchk";
	};

	clocks {

		clk32k {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x7d00>;
			phandle = <0xdf>;
		};

		clk26m {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x18cba80>;
