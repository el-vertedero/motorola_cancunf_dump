/dts-v1/;

/ {
	model = "MT6855";
	compatible = "mediatek,MT6855";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;

	clkitg {
		compatible = "simple-bus";
		status = "okay";
		phandle = <0xdd>;

		bring-up {
			compatible = "mediatek,clk-bring-up";
			clocks = <0x02 0x00 0x02 0x01 0x02 0x02 0x02 0x03 0x02 0x18 0x02 0x19 0x02 0x21 0x02 0x29 0x02 0x2e 0x02 0x2f 0x02 0x30 0x02 0x31 0x02 0x32 0x02 0x34 0x03 0x00 0x03 0x01 0x03 0x02 0x03 0x04 0x03 0x05 0x03 0x06 0x03 0x07 0x03 0x08 0x03 0x0a 0x03 0x0b 0x03 0x0c 0x03 0x0d 0x03 0x0e 0x03 0x0f 0x03 0x10 0x03 0x11 0x03 0x12 0x03 0x13 0x03 0x15 0x03 0x16 0x03 0x17 0x03 0x18 0x03 0x19 0x03 0x1a 0x04 0x00 0x04 0x01 0x04 0x02 0x04 0x03 0x04 0x04 0x04 0x05 0x04 0x06 0x04 0x07 0x04 0x08 0x04 0x09 0x04 0x0a 0x04 0x0b 0x04 0x0c 0x04 0x0d>;
